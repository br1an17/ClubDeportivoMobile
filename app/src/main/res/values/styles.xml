<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="MarcoGeneralPantalla">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:background">#000000</item>
        <item name="android:paddingStart">40dp</item>
        <item name="android:paddingEnd">40dp</item>
    </style>

    <style name="BotonMenu">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:layout_marginStart">32dp</item>
        <item name="android:layout_marginEnd">32dp</item>
        <item name="android:backgroundTint">@color/GreenStrong</item>
        <item name="android:textColor">@color/black</item>
       <item name="android:textSize">23sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="BotonVolver">
        <item name="android:layout_width">220dp</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:layout_marginBottom">18dp</item>
        <item name="android:backgroundTint">@color/GreenStrong</item>
        <item name="android:text">@string/volver</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Inputs">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginBottom">28dp</item>
        <item name="android:background">@drawable/line_bottom_green</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textColorHint">#A0A0A0</item>
    </style>

    <style name="logoGrande">
       <item name="android:layout_width">300dp</item>
       <item name="android:layout_height">200dp</item>
       <item name="android:layout_marginBottom">32dp</item>
       <item name="android:contentDescription">@string/descriptionLogo</item>
       <item name="android:scaleType">fitCenter</item>
       <item name="android:src">@drawable/logo</item>
    </style>
</resources>