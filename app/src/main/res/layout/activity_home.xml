<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/MarcoGeneralPantalla">

    <TextView
        android:id="@+id/tvBienvenida"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="30dp"
        android:text="Bienvenido administrador:"
        android:textColor="#FFFFFF"
        android:textSize="25sp"
        android:textStyle="bold" />

    <!-- 3. Subtítulo -->
    <TextView
        android:id="@+id/tvSubtitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="100dp"
        android:text="nombre"
        android:textColor="#DEDDDD"
        android:textSize="25sp" />

    <Button
        android:id="@+id/btnRegistro"
        android:text="Registro"
        style="@style/BotonMenu"
       />

    <Button
        android:id="@+id/btnBuscarUsuario"
        android:text="Buscar usuario"
        style="@style/BotonMenu"
        />
    <Button
        android:id="@+id/btnVenceHoy"
        android:text="Cuota a Vencer"
        style="@style/BotonMenu"
       />
    <Button
        android:id="@+id/btnVencida"
        android:text="Cuota Vencida"
        style="@style/BotonMenu"
         />



    <Button
        android:id="@+id/btnVolver"
        style="@style/BotonVolver"/>


    <ImageView
        android:id="@+id/imgLogoLogin"
        android:layout_width="160dp"
        android:layout_height="120dp"
        android:layout_marginTop="16dp"
        android:contentDescription="Logo Club"
        android:scaleType="fitCenter"
        android:src="@drawable/logo" />

</LinearLayout>