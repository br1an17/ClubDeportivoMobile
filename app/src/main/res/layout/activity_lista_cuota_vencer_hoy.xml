<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="32dp">

        <!-- Título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="22dp"
            android:text="Socios Cuota Vence Hoy"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold" />

        <!-- Buscador -->
        <EditText
            android:id="@+id/etBuscar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_input"
            android:hint="Buscar por nombre, DNI o Nº de cliente"
            android:inputType="text"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/black"
            android:textColorHint="#666666"
            android:textSize="14sp"
            android:singleLine="true" />

        <!-- Cantidad por página -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mostrar:"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginEnd="10dp" />

            <Spinner
                android:id="@+id/spLimite"
                android:layout_width="90dp"
                android:layout_height="45dp"
                android:backgroundTint="@color/GreenStrong" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="por página"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:layout_marginStart="10dp" />

        </LinearLayout>

        <!-- Lista de socios -->
        <LinearLayout
            android:id="@+id/contenedorClientes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Paginación -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="22dp">

            <Button
                android:id="@+id/btnAnterior"
                android:layout_width="105dp"
                android:layout_height="48dp"
                android:backgroundTint="@color/GreenStrong"
                android:text="Anterior"
                android:textColor="@color/black"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="false" />

            <TextView
                android:id="@+id/tvPagina"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:text="Página 1 de 1"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSiguiente"
                android:layout_width="105dp"
                android:layout_height="48dp"
                android:backgroundTint="@color/GreenStrong"
                android:text="Siguiente"
                android:textColor="@color/black"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="false" />

        </LinearLayout>

        <!-- Botón Menú -->
        <Button
            android:id="@+id/btnMenu"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="@color/GreenStrong"
            android:text="Menú"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false" />

        <!-- Logo -->
        <ImageView
            android:id="@+id/imgLogoListaCuota"
            android:layout_width="160dp"
            android:layout_height="120dp"
            android:contentDescription="Logo Club"
            android:scaleType="fitCenter"
            android:src="@drawable/logo" />

    </LinearLayout>

</ScrollView>