<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="32dp">

        <!-- Título principal -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="32dp"
            android:text="Cobro de Cuota"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Nombre -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etNombre"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_input"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#121212"
            android:textSize="15sp"
            android:singleLine="true"
            android:focusable="false"
            android:clickable="false"
            android:cursorVisible="false" />

        <!-- DNI -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DNI"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etDni"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_input"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#121212"
            android:textSize="15sp"
            android:singleLine="true"
            android:focusable="false"
            android:clickable="false"
            android:cursorVisible="false" />

        <!-- Monto -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Monto"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etMonto"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="32dp"
            android:background="@drawable/bg_input"
            android:inputType="numberDecimal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#121212"
            android:textSize="15sp"
            android:singleLine="true" />

        <!-- Medios de pago -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/btnTarjeta"
                android:layout_width="112dp"
                android:layout_height="50dp"
                android:layout_marginEnd="14dp"
                android:backgroundTint="@color/GreenStrong"
                android:text="Tarjeta"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnEfectivo"
                android:layout_width="112dp"
                android:layout_height="50dp"
                android:backgroundTint="@color/GreenStrong"
                android:text="Efectivo"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAllCaps="false" />

        </LinearLayout>

        <!-- Cobrar -->
        <Button
            android:id="@+id/btnCobrar"
            android:layout_width="140dp"
            android:layout_height="50dp"
            android:layout_marginBottom="32dp"
            android:backgroundTint="@color/GreenStrong"
            android:text="Cobrar"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false" />

        <!-- Comprobante -->
        <Button
            android:id="@+id/btnComprobante"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="32dp"
            android:backgroundTint="@color/GreenStrong"
            android:text="Comprobante"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false" />

        <!-- Volver -->
        <Button
            android:id="@+id/btnVolver"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="@color/GreenStrong"
            android:text="Volver"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false" />

        <!-- Logo -->
        <ImageView
            android:id="@+id/imgLogoCobro"
            android:layout_width="160dp"
            android:layout_height="120dp"
            android:contentDescription="Logo Club"
            android:scaleType="fitCenter"
            android:src="@drawable/logo" />

    </LinearLayout>

</ScrollView>