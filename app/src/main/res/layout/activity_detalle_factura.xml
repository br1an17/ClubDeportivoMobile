
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DETALLE DE FACTURA"
            android:textColor="@color/white"
            android:textSize="23sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="25dp" />

        <!-- NÚMERO -->

        <TextView
            android:id="@+id/tvNumeroDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Factura: FAC-000000"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="15dp" />

        <!-- CLIENTE -->

        <TextView
            android:id="@+id/tvClienteDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <!-- FECHA -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fecha de emisión:"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvFechaDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:layout_marginBottom="12dp" />

        <!-- MEDIO DE PAGO -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Medio de pago:"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvFormaPagoDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:layout_marginBottom="12dp" />

        <!-- CUOTAS -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Financiación:"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvCuotasDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:layout_marginBottom="12dp" />

        <!-- ESTADO -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Estado:"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvEstadoDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:layout_marginBottom="25dp" />

        <!-- DETALLE DE CONCEPTOS -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Actividades y conceptos cobrados"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="15dp" />

        <LinearLayout
            android:id="@+id/contenedorDetallesFactura"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- TOTAL -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TOTAL DE LA FACTURA"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="15dp" />

        <TextView
            android:id="@+id/tvTotalDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/GreenStrong"
            android:textSize="25sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="25dp" />

        <!-- BOTÓN COMPROBANTE -->

        <Button
            android:id="@+id/btnVerComprobanteDetalle"
            style="@style/BotonMenu"
            android:text="Ver comprobante" />

        <!-- BOTÓN VOLVER -->

        <Button
            android:id="@+id/btnVolverDetalle"
            style="@style/BotonVolver"
            android:text="Volver" />

        <!-- LOGO -->

        <ImageView
            android:layout_width="160dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:layout_marginTop="15dp"
            android:contentDescription="Logo Club"
            android:scaleType="fitCenter"
            android:src="@drawable/logo" />

    </LinearLayout>

</ScrollView>
