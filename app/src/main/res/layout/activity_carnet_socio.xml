<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- Título de la pantalla -->
        <TextView
            android:id="@+id/tvTituloCarnet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Carnet de Socio"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="20dp" />

        <!-- Imagen del QR -->
        <ImageView
            android:id="@+id/ivCodigoQR"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_launcher_background"
            tools:srcCompat="@tools:sample/avatars" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mostrá este código para validar tu carnet de socio"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp" />

        <!-- Fila: N° de Afiliado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="140dp"
                android:layout_height="wrap_content"
                android:text="N.° de Afiliado"
                android:background="#55FF00"
                android:textColor="@android:color/black"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="10dp" />

            <TextView
                android:id="@+id/tvNumAfiliado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:paddingStart="16dp"
                tools:text="123456" />
        </LinearLayout>

        <!-- Fila: Nombre -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="140dp"
                android:layout_height="wrap_content"
                android:text="Nombre"
                android:background="#55FF00"
                android:textColor="@android:color/black"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="10dp" />

            <TextView
                android:id="@+id/tvNombreSocio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:paddingStart="16dp"
                tools:text="Juan Pérez" />
        </LinearLayout>

        <!-- Fila: Documento -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="140dp"
                android:layout_height="wrap_content"
                android:text="Documento"
                android:background="#55FF00"
                android:textColor="@android:color/black"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="10dp" />

            <TextView
                android:id="@+id/tvDocumentoSocio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:paddingStart="16dp"
                tools:text="40123456" />
        </LinearLayout>

        <!-- Fila: Estado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="140dp"
                android:layout_height="wrap_content"
                android:text="Estado"
                android:background="#55FF00"
                android:textColor="@android:color/black"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="10dp" />

            <TextView
                android:id="@+id/tvEstadoSocio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:paddingStart="16dp"
                tools:text="Al día" />
        </LinearLayout>

        <!-- Botón Volver -->
        <Button
            android:id="@+id/btnVolverCarnet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Volver"
            android:backgroundTint="#55FF00"
            android:textColor="@android:color/black"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp" />

    </LinearLayout>
</ScrollView>